MDFloatLayout:
    ScreenManager:
        id: screen_manager
        MainScreen:
        SettingsScreen:
        ClassAddScreen:
        SignInScreen:
        WebsiteDataScreen:
        ClassEditScreen:
        ClassesScreen:


    # This floats above the ScreenManager
    TopNotification:
        id: global_notif

# --- Define the Notification Visuals ---
<TopNotification>:
    size_hint: 0.85, None
    height: "50dp"
    # Change 'y' to 'top: 1.2' to prevent coordinate conflicts
    pos_hint: {"center_x": 0.5, "top": 1.2}
    elevation: 3
    radius: [12]
    md_bg_color: 0.15, 0.15, 0.15, 1 # Dark gray background

    MDLabel:
        text: root.message_text
        theme_text_color: "Custom"
        text_color: root.message_color
        halign: "center"
        bold: True

<MainScreen>:
    name: "main"
    MDFloatLayout:

        # --- Top Navigation ---
        MDRaisedButton:
            text: "Sign in"
            elevation: 2
            pos_hint: {"top": 0.96, "x": 0.04}
            on_release: root.manager.current = "sign in"

        MDIconButton:
            icon: "cog"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "settings"

        # --- Header ---
        MDLabel:
            text: "U-bubble"
            font_style: "H3"
            bold: True
            halign: "center"
            pos_hint: {"center_y": 0.88}
            theme_text_color: "Primary"

        # --- Classes Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.25
            pos_hint: {"center_x": 0.5, "center_y": 0.65}
            elevation: 2
            radius: [16]
            padding: "16dp"

            MDLabel:
                text: "Classes"
                font_style: "H5"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]

            Widget: # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDFillRoundFlatIconButton:
                    text: "Edit"
                    icon: "pencil"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_release: root.manager.current = "edit class"

                MDFillRoundFlatIconButton:
                    text: "Add"
                    icon: "plus"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_release: root.manager.current = "add a class"

        # --- Updates Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.25
            pos_hint: {"center_x": 0.5, "center_y": 0.35}
            elevation: 2
            radius: [16]
            padding: "16dp"

            MDLabel:
                text: "Get assignments"
                font_style: "H5"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]

            Widget: # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDRaisedButton:
                    text: "Auto"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5

                MDRaisedButton:
                    text: "Classes page"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_press: root.manager.current = "classes"

<SettingsScreen>:
    name: "settings"
    MDFloatLayout:

        MDLabel:
            text: "Settings"
            font_style: "H4"
            bold: True
            halign: "center"
            pos_hint: {"top": 0.90}

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"

        # --- Main Settings Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.48}
            elevation: 2
            radius: [16]
            padding: "24dp"
            spacing: "20dp"

            MDFillRoundFlatIconButton:
                icon: "google"
                text: "Connect Google"
                md_bg_color: 0.8, 0.1, 0.1, 1  # Professional Red
                font_size: "18sp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.9
                on_press: root.connect_google()

            MDSeparator:
                size_hint_x: 0.6
                pos_hint: {"center_x": 0.5}

            MDRaisedButton:
                text: "Connect Blackboard"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("blackboard")
                on_release: root.manager.current = "enter web data"

            MDRaisedButton:
                text: "Connect Zybooks"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("zybooks")
                on_release: root.manager.current = "enter web data"

            MDRaisedButton:
                text: "Connect Cengage"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("cengage")
                on_release: root.manager.current = "enter web data"

            MDRaisedButton:
                text: "Connect Demo"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("demo")
                on_release: root.manager.current = "enter web data"

            Widget: # Bottom Spacer inside card

        # --- Bottom System Update Bar ---
        MDBoxLayout:
            orientation: "horizontal"
            size_hint: 0.85, None
            height: "48dp"
            pos_hint: {"center_x": 0.5, "y": 0.05}

            MDLabel:
                text: "Auto-Update: ON"
                theme_text_color: "Hint"
                halign: "left"

            MDIconButton:
                icon: "refresh"
                on_press: root.update()



<WebsiteDataScreen>:
    name: "enter web data"
    MDFloatLayout:

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"

        # --- Form Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [16]
            padding: "24dp"
            spacing: "20dp"

            MDLabel:
                text: "Add Account"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "15dp"

            MDTextField:
                id: username_field
                hint_text: "Enter email or username:"
                helper_text: "Example: Simeon@gmail.com"
                helper_text_mode: "on_focus"
                icon_right: "account"
                mode: "rectangle"

            MDTextField:
                id: password_field
                hint_text: "Enter password:"
                helper_text: "Example: HelloWorld123"
                helper_text_mode: "on_focus"
                icon_right: "key-variant"
                password: True  # Changed to True so it properly hides the characters
                mode: "rectangle"

            Widget: # Spacer

            MDFillRoundFlatButton:
                text: "Submit"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.save_to_login()
                on_release: root.manager.current = "main"


<ClassAddScreen>:
    name: "add a class"
    MDFloatLayout:

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"

        # --- Form Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.75
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [16]
            padding: "24dp"
            spacing: "15dp"

            MDLabel:
                text: "New Class"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "10dp"

            MDTextField:
                id: class_name
                hint_text: "Enter Class Name:"
                helper_text: "Example: Math"
                helper_text_mode: "on_focus"
                icon_right: "book-open-outline"
                mode: "rectangle"

            MDTextField:
                id: assignment_website
                hint_text: "Enter Assignment Website:"
                helper_text: "Example: blackboard"
                helper_text_mode: "on_focus"
                icon_right: "web"
                mode: "rectangle"

            MDTextField:
                id: class_identifier
                hint_text: "Enter Class Identifier:"
                helper_text: "Example: MATH-126-009"
                helper_text_mode: "on_focus"
                icon_right: "tag"
                mode: "rectangle"

            MDTextField:
                id: assignment_page_input
                hint_text: "Enter the Assignment Page Link:"
                helper_text: "Example: school.com/assignments"
                helper_text_mode: "on_focus"
                icon_right: "link"
                mode: "rectangle"

            Widget: # Spacer

            MDFillRoundFlatButton:
                text: "+ ADD this class"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.save_to_class()
                on_release: root.manager.current = "main"

<SignInScreen>:
    name: "sign in"
    MDFloatLayout:

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"

        # --- Form Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [16]
            padding: "24dp"
            spacing: "20dp"

            MDLabel:
                text: "Create Account"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "15dp"

            MDTextField:
                id: username_field
                hint_text: "Create username:"
                helper_text: "Example: Simeon"
                helper_text_mode: "on_focus"
                icon_right: "account"
                mode: "rectangle"

            MDTextField:
                id: pin_field
                hint_text: "Create pin:"
                helper_text: "Example: 19674"
                helper_text_mode: "on_focus"
                icon_right: "key-variant"
                password: True
                mode: "rectangle"

            Widget: # Spacer

            MDFillRoundFlatButton:
                text: "Submit"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.sign_in()
                on_release: root.manager.current = "main"

<ClassEditScreen>:
    name: "edit class"

    MDFloatLayout:

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"

        # --- Form Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.75
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [16]
            padding: "24dp"
            spacing: "15dp"

            MDLabel:
                text: "Edit Class"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "10dp"

            MDLabel:
                text: "  Select class to replace"
                font_style: "H5"
                pos_hint: {"center_x": 0.8}




            MDRaisedButton:
                id: class_dropdown_btn
                text: "Select a Class"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.4
                # This calls the function we are about to create in Python
                on_release: root.open_menu()

            MDTextField:
                id: class_name
                hint_text: "new Class Name:"
                helper_text: "Example: Math"
                helper_text_mode: "on_focus"
                icon_right: "book-open-outline"
                mode: "rectangle"

            MDTextField:
                id: assignment_website
                hint_text: "new Assignment Website:"
                helper_text: "Example: blackboard"
                helper_text_mode: "on_focus"
                icon_right: "web"
                mode: "rectangle"

            MDTextField:
                id: class_identifier
                hint_text: "Enter Class Identifier:"
                helper_text: "Example: MATH-126-009"
                helper_text_mode: "on_focus"
                icon_right: "tag"
                mode: "rectangle"

            Widget: # Spacer

            MDFillRoundFlatButton:
                text: "Submit"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.enter_className(); root.enter_classID(); root.enter_classWeb(); root.save_data(); root.print_assignments()
                on_release: root.manager.current = "main"

<ClassesScreen>:
    name: "classes"
    md_bg_color: 0.08, 0.08, 0.08, 1 # Dark gray/almost black background

    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(20)

        # 1. Main Header and Home Button
        MDLabel:
            text: "Class to Tasks Screen"
            font_style: "H4"
            theme_text_color: "Custom"
            text_color: 0.1, 0.7, 0.2, 1 # Retro Green
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1]

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"

        # 2. Outer Layout for Sidebar and Main Content
        MDBoxLayout:
            orientation: 'horizontal'
            spacing: dp(20)

            # Sidebar (Left Side)
            MDBoxLayout:
                orientation: 'vertical'
                spacing: dp(15)
                size_hint_x: 0.3

                # Cluster button
                MDFillRoundFlatButton:
                    text: "Cluster"
                    size_hint_x: 1
                    size_hint_y: 0.25
                    font_style: "H5"
                    bold: True
                    on_release: root.update_panel("Cluster", "All")

                # Sidebar Buttons
                MDFillRoundFlatButton:
                    text: "Science"
                    size_hint_x: 1
                    size_hint_y: 0.15
                    md_bg_color: 0.3, 0.18, 0.0, 1 # Brownish
                    text_color: 0.9, 0.5, 0.0, 1
                    font_style: "H6"
                    bold: True
                    on_release: root.update_panel("Science-263", "Cengage")

                MDFillRoundFlatButton:
                    text: "Geology"
                    size_hint_x: 1
                    size_hint_y: 0.15
                    md_bg_color: 0.3, 0.18, 0.0, 1
                    text_color: 0.9, 0.5, 0.0, 1
                    font_style: "H6"
                    bold: True
                    on_release: root.update_panel("Geology-101", "Zybooks")

                MDFillRoundFlatButton:
                    text: "Engineering"
                    size_hint_x: 1
                    size_hint_y: 0.15
                    md_bg_color: 0.3, 0.18, 0.0, 1
                    text_color: 0.9, 0.5, 0.0, 1
                    font_style: "H6"
                    bold: True
                    on_release: root.update_panel("Engineering-101", "Blackboard")

                MDFillRoundFlatButton:
                    text: "MATH"
                    size_hint_x: 1
                    size_hint_y: 0.2
                    md_bg_color: 0.08, 0.25, 0.35, 1 # Deep Blue
                    text_color: 0.3, 0.7, 0.9, 1 # Light Blue
                    font_style: "H4"
                    bold: True
                    on_release: root.update_panel("Math-105", "Blackboard")

            # Main Content Panel (Right Side)
            MDCard:
                id: main_content_panel
                orientation: 'vertical'
                padding: dp(25)
                spacing: dp(15)
                md_bg_color: 0.05, 0.05, 0.05, 1
                line_color: 0.4, 0.6, 0.8, 1 # Blueish border
                radius: [20, 20, 20, 20]
                size_hint_x: 0.7

                # Panel Header (Title & Button)
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(60)

                    MDBoxLayout:
                        orientation: 'vertical'
                        MDLabel:
                            id: class_title
                            text: "Math-105"
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.9, 0.9, 1
                        MDLabel:
                            id: class_website
                            text: "Blackboard"
                            font_style: "H5"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.6, 0.5, 1.0, 1 # Purple

                    MDRoundFlatButton:
                        text: "Send to tasks"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        line_color: 1, 1, 1, 1.
                        font_style: "Subtitle1"
                        bold: True
                        pos_hint: {"center_y": .5}
                        on_press: root.get_assignments_to_tasks()

                # Divider Line
                MDSeparator:
                    color: 1, 1, 1, 1
                    height: dp(2)

                # Blackboard Content Area
                MDRelativeLayout:

                    MDCard:
                        md_bg_color: 0.3, 0.18, 0.35, 1 # Main purple background
                        line_color: 0.6, 0.5, 1.0, 1 # Light purple outer border
                        radius: [15, 15, 15, 15]
                        padding: dp(15)

                        # Placeholder for drawing/text
                        MDLabel:
                            id: copy_box
                            text: " "
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                    # Floating Copy Button
                    MDFillRoundFlatButton:
                        text: "Copy"
                        md_bg_color: 0.1, 0.3, 0.5, 1 # Blue button
                        text_color: 0.5, 0.7, 1.0, 1
                        line_color: 0.3, 0.6, 0.9, 1
                        bold: True
                        font_style: "H6"
                        pos_hint: {"top": 0.92, "right": 0.96}
                        on_press: root.copy_to_clipboard()