MDFloatLayout:
    ScreenManager:
        id: screen_manager
        MainScreen:
        SettingsScreen:
        ClassAddScreen:
        SignInScreen:
        WebsiteDataScreen:
        ClassEditScreen:
        ClassesScreen:


    # This floats above the ScreenManager
    TopNotification:
        id: global_notif

# --- Define the Notification Visuals ---
<TopNotification>:
    size_hint: 0.85, None
    height: "50dp"
    # Change 'y' to 'top: 1.2' to prevent coordinate conflicts
    pos_hint: {"center_x": 0.5, "top": 1.2}
    elevation: 3
    radius: [12]
    md_bg_color: 0.15, 0.15, 0.15, 1 # Dark gray background

    MDLabel:
        text: root.message_text
        theme_text_color: "Custom"
        text_color: root.message_color
        halign: "center"
        bold: True

<MainScreen>:
    name: "main"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1

        # --- Top Navigation ---
        MDRaisedButton:
            id: sign_in_button
            text: "Sign in"
            elevation: 2
            pos_hint: {"top": 0.96, "x": 0.04}
            on_release: root.manager.current = "sign in"
            font_name: "Comic"
            md_bg_color: 0.3, 0.2, 0.4, 1
            text_color: 1, 1, 1, 1

        MDIconButton:
            icon: "cog"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "settings"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1

        # --- Header ---
        MDLabel:
            text: "U-Bubble"
            font_style: "H2"
            bold: True
            halign: "center"
            pos_hint: {"center_y": 0.88}
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1
            font_name: "data/fonts/Roboto-BoldItalic.ttf"

        # --- Classes Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.25
            pos_hint: {"center_x": 0.5, "center_y": 0.65}
            elevation: 2
            radius: [24]
            padding: "16dp"
            md_bg_color: 0.2, 0.2, 0.2, 1

            MDLabel:
                text: "Classes"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                font_name: "RobotoLight"
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1

            Widget: # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDFillRoundFlatIconButton:
                    text: "Edit"
                    icon: "pencil"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_release: root.manager.current = "edit class"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1

                MDFillRoundFlatIconButton:
                    text: "Add"
                    icon: "plus"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_release: root.manager.current = "add a class"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1

        # --- Updates Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.25
            pos_hint: {"center_x": 0.5, "center_y": 0.35}
            elevation: 2
            radius: [24]
            padding: "16dp"
            md_bg_color: 0.2, 0.2, 0.2, 1

            MDLabel:
                text: "Get assignments"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                font_name: "RobotoLight"
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1

            Widget: # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDRaisedButton:
                    text: "Auto (disabled)"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    disabled: True
                    font_name: "RobotoMedium"

                MDFillRoundFlatIconButton:
                    text: "Classes page"
                    icon: "view-list"  # Added icon
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_press: root.manager.current = "classes"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1

<SettingsScreen>:
    name: "settings"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1 # Consistent background

        MDLabel:
            text: "Settings"
            font_style: "H4"
            bold: True
            halign: "center"
            pos_hint: {"top": 0.95}
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1 # Purple header
            font_name: "Roboto"

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1

        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.8
            pos_hint: {"center_x": 0.5, "center_y": 0.45}
            elevation: 2
            radius: [24] # Rounded corners
            padding: "24dp"
            spacing: "20dp"
            md_bg_color: 0.2, 0.2, 0.2, 1 # Darker card background

            MDFillRoundFlatIconButton:
                icon: "google"
                text: "Connect Google"
                md_bg_color: 0.8, 0.1, 0.1, 1
                font_size: "18sp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.9
                on_press: root.connect_google()
                font_name: "Roboto"

            MDSeparator:
                size_hint_x: 0.6
                pos_hint: {"center_x": 0.5}
                color: 0.4, 0.3, 0.5, 1 # Purple separator

            MDRaisedButton:
                text: "Connect Blackboard"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("blackboard")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1

            MDRaisedButton:
                text: "Connect Zybooks"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("zybooks")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1

            MDRaisedButton:
                text: "Connect Cengage"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("cengage")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1

            MDRaisedButton:
                text: "Connect Demo"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("demo")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1

            MDLabel:
                text: "Gemini API Setup"
                font_style: "H6"
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1
                font_name: "Roboto"

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "48dp"
                spacing: "10dp"
                pos_hint: {"center_x": 0.5}

                MDRaisedButton:
                    text: "Get Key"
                    on_release: root.get_gemini_key()
                    size_hint_x: 0.3
                    font_name: "Roboto"
                    md_bg_color: 0.4, 0.3, 0.5, 1

                MDTextField:
                    id: api_key_field
                    hint_text: "Paste API Key"
                    mode: "rectangle"
                    password: True
                    size_hint_x: 0.4
                    font_name: "Roboto"
                    line_color_normal: 0.4, 0.3, 0.5, 1
                    line_color_focus: 0.8, 0.6, 1, 1
                    text_color_normal: 0.9, 0.9, 0.9, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1

                MDFillRoundFlatButton:
                    text: "Submit"
                    on_release: root.save_api_key()
                    size_hint_x: 0.3
                    font_name: "Roboto"
                    md_bg_color: 0.4, 0.3, 0.5, 1

<WebsiteDataScreen>:
    name: "enter web data"
    MDFloatLayout:

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"

        # --- Form Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [16]
            padding: "24dp"
            spacing: "20dp"

            MDLabel:
                text: "Add Account"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "15dp"

            MDTextField:
                id: username_field
                hint_text: "Enter email or username:"
                helper_text: "Example: Simeon"
                helper_text_mode: "on_focus"
                icon_right: "account"
                mode: "rectangle"

            MDTextField:
                id: password_field
                hint_text: "Enter password:"
                helper_text: "Example: HelloWorld123"
                helper_text_mode: "on_focus"
                icon_right: "key-variant"
                password: True  # Changed to True so it properly hides the characters
                mode: "rectangle"

            Widget: # Spacer

            MDFillRoundFlatButton:
                text: "Submit"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.save_to_login()
                on_release: root.manager.current = "main"


<ClassAddScreen>:
    name: "add a class"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1 # Consistent background

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp" # Added
            theme_text_color: "Custom" # Added
            text_color: 0.8, 0.6, 1, 1 # Added

        # --- Form Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.65 # Adjusted size_hint
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [24] # Rounded corners
            padding: "24dp"
            spacing: "20dp" # Adjusted spacing for better look
            md_bg_color: 0.2, 0.2, 0.2, 1 # Darker card background

            MDLabel:
                text: "New Class"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "10dp"
                theme_text_color: "Custom" # Added
                text_color: 0.8, 0.6, 1, 1 # Purple header
                font_name: "data/fonts/Roboto-BoldItalic.ttf" # Added

            MDTextField:
                id: class_name
                hint_text: "Enter Class Name:"
                helper_text: "Example: Math"
                helper_text_mode: "on_focus"
                icon_right: "book-open-outline"
                mode: "rectangle"
                font_name: "Roboto" # Added
                line_color_normal: 0.4, 0.3, 0.5, 1 # Added
                line_color_focus: 0.9, 0.9, 1, 1 # Added
                text_color_normal: 0.9, 0.9, 0.9, 1 # Added
                hint_text_color: 0.6, 0.6, 0.6, 1 # Added

            MDTextField:
                id: assignment_website
                hint_text: "Enter Assignment Website:"
                helper_text: "Example: blackboard"
                helper_text_mode: "on_focus"
                icon_right: "web"
                mode: "rectangle"
                font_name: "Roboto" # Added
                line_color_normal: 0.4, 0.3, 0.5, 1 # Added
                line_color_focus: 0.9, 0.9, 1, 1 # Added
                text_color_normal: 0.9, 0.9, 0.9, 1 # Added
                hint_text_color: 0.6, 0.6, 0.6, 1 # Added

            MDTextField:
                id: assignment_page_input
                hint_text: "Enter the Assignment Page Link:"
                helper_text: "Example: school.com/assignments"
                helper_text_mode: "on_focus"
                icon_right: "link"
                mode: "rectangle"
                font_name: "Roboto" # Added
                line_color_normal: 0.4, 0.3, 0.5, 1 # Added
                line_color_focus: 0.9, 0.9, 1, 1 # Added
                text_color_normal: 0.9, 0.9, 0.9, 1 # Added
                hint_text_color: 0.6, 0.6, 0.6, 1 # Added

            Widget: # Spacer

            MDFillRoundFlatButton:
                text: "+ ADD this class"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.save_to_class()
                md_bg_color: 0.4, 0.3, 0.5, 1
                on_release: root.manager.current = "main"
                font_name: "RobotoMedium" # Added

<SignInScreen>:
    name: "sign in"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1 # Consistent background

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1

        # --- Form Card ---
        MDCard:
            id: sign_in_card
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [24] # Rounded corners
            padding: "24dp"
            spacing: "20dp"
            md_bg_color: 0.2, 0.2, 0.2, 1 # Darker card background

            MDLabel:
                text: "Create Account or Log Back In"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "15dp"
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1
                font_name: "Comic"

            MDTextField:
                id: username_field
                hint_text: "Create username:"
                helper_text: "Example: Simeon"
                helper_text_mode: "on_focus"
                icon_right: "account"
                mode: "rectangle"
                font_name: "Roboto"
                line_color_normal: 0.4, 0.3, 0.5, 1
                line_color_focus: 0.9, 0.9, 1, 1
                text_color_normal: 0.9, 0.9, 0.9, 1
                hint_text_color: 0.6, 0.6, 0.6, 1

            MDTextField:
                id: pin_field
                hint_text: "Create pin:"
                helper_text: "Example: 19674"
                helper_text_mode: "on_focus"
                icon_right: "key-variant"
                password: True
                mode: "rectangle"
                font_name: "Roboto"
                line_color_normal: 0.4, 0.3, 0.5, 1
                line_color_focus: 0.9, 0.9, 1, 1
                text_color_normal: 0.9, 0.9, 0.9, 1
                hint_text_color: 0.6, 0.6, 0.6, 1


            Widget: # Spacer

            MDFillRoundFlatButton:
                text: "Submit"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.sign_in()
                on_release: root.manager.current = "main"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1

        MDFillRoundFlatButton:
            id: sign_out_button
            text: "Log Out"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            size_hint: 0.6, 0.1
            opacity: 0
            disabled: True
            on_release: root.sign_out()
            font_name: "Comic"
            md_bg_color: 0.8, 0.1, 0.1, 1 # Red for logout

<ClassEditScreen>:
    name: "edit class"

    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1 # Consistent background

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1

        # --- Form Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.75
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [24] # Rounded corners
            padding: "24dp"
            spacing: "15dp"
            md_bg_color: 0.2, 0.2, 0.2, 1 # Darker card background

            MDLabel:
                text: "Edit Class"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "10dp"
                theme_text_color: "Custom" # Added
                text_color: 0.8, 0.6, 1, 1 # Purple header
                font_name: "data/fonts/Roboto-BoldItalic.ttf" # Added


            MDLabel:
                text: "Select class to replace"
                font_style: "H5"
                halign: "center" # Centered on x-axis
                pos_hint: {"center_x": 0.5} # Centered on x-axis
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1
                font_name: "RobotoLight"


            MDRaisedButton:
                id: class_dropdown_btn
                text: "Select a Class"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.4
                on_release: root.open_menu()
                font_name: "RobotoMedium"
                md_bg_color: 0.4, 0.3, 0.5, 1

            MDTextField:
                id: class_name
                hint_text: "new Class Name:"
                helper_text: "Example: Math"
                helper_text_mode: "on_focus"
                icon_right: "book-open-outline"
                mode: "rectangle"
                font_name: "RobotoMedium"
                line_color_normal: 0.4, 0.3, 0.5, 1
                line_color_focus: 0.9, 0.9, 1, 1
                text_color_normal: 0.9, 0.9, 0.9, 1
                hint_text_color: 0.6, 0.6, 0.6, 1

            MDTextField:
                id: assignment_website
                hint_text: "new Assignment Website:"
                helper_text: "Example: blackboard"
                helper_text_mode: "on_focus"
                icon_right: "web"
                mode: "rectangle"
                font_name: "RobotoMedium"
                line_color_normal: 0.4, 0.3, 0.5, 1
                line_color_focus: 0.9, 0.9, 1, 1
                text_color_normal: 0.9, 0.9, 0.9, 1
                hint_text_color: 0.6, 0.6, 0.6, 1

            MDTextField:
                id: assignment_page
                hint_text: "Enter Class Page Link:"
                helper_text: "Example: MATH-126-009"
                helper_text_mode: "on_focus"
                icon_right: "tag"
                mode: "rectangle"
                font_name: "RobotoMedium"
                line_color_normal: 0.4, 0.3, 0.5, 1
                line_color_focus: 0.9, 0.9, 1, 1
                text_color_normal: 0.9, 0.9, 0.9, 1
                hint_text_color: 0.6, 0.6, 0.6, 1

            Widget: # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDFillRoundFlatButton:
                    text: "Delete Class"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_press: root.delete_class() # Assuming a delete_class method
                    font_name: "RobotoMedium"
                    md_bg_color: 0.8, 0.1, 0.1, 1 # Red for delete

                MDFillRoundFlatButton:
                    text: "Complete Edit"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_press: root.edit()
                    on_release: root.manager.current = "main"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1

<ClassesScreen>:
    name: "classes"
    on_enter: root.populate_classes()
    md_bg_color: 0.08, 0.08, 0.08, 1

    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(20)

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: self.minimum_height
            MDLabel:
                text: "Send assignments to Tasks"
                font_style: "H4"
                theme_text_color: "Custom"
                text_color: 0.8, 0.6, 1, 1
                font_name: "data/fonts/Roboto-BoldItalic.ttf"
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
            MDIconButton:
                icon: "home"
                pos_hint: {"center_y": 0.5}
                icon_size: "48sp"
                theme_text_color: "Custom"
                text_color: 0.8, 0.6, 1, 1
                on_release: root.manager.current = "main"

        MDBoxLayout:
            orientation: 'horizontal'
            spacing: dp(20)

            ScrollView:
                size_hint_x: 0.4
                MDBoxLayout:
                    id: class_button_container
                    orientation: 'vertical'
                    spacing: dp(15)
                    size_hint_y: None
                    height: self.minimum_height
                    MDFillRoundFlatButton:
                        text: "Add Class"
                        on_release: root.manager.current = "add a class"
                        size_hint_x: 1
                        height: "48dp"

            MDCard:
                id: main_content_panel
                orientation: 'vertical'
                padding: dp(25)
                spacing: dp(15)
                md_bg_color: 0.05, 0.05, 0.05, 1
                line_color: 0.4, 0.6, 0.8, 1
                radius: [20, 20, 20, 20]
                size_hint_x: 0.6

                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(60)

                    MDBoxLayout:
                        orientation: 'vertical'
                        MDLabel:
                            id: class_title
                            text: "Class Title"
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.9, 0.9, 1
                        MDLabel:
                            id: class_website
                            text: "Class Website"
                            font_style: "H5"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.6, 0.5, 1.0, 1

                    MDRoundFlatButton:
                        text: "Send to tasks"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        line_color: 1, 1, 1, 1
                        font_style: "Subtitle1"
                        bold: True
                        pos_hint: {"center_y": .5}
                        on_press: root.get_assignments_to_tasks()

                MDSeparator:
                    color: 1, 1, 1, 1
                    height: dp(2)

                MDRelativeLayout:
                    MDCard:
                        md_bg_color: 0.3, 0.18, 0.35, 1
                        line_color: 0.6, 0.5, 1.0, 1
                        radius: [15, 15, 15, 15]
                        padding: dp(15)

                        MDLabel:
                            id: copy_box
                            text: " "
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                    MDFillRoundFlatButton:
                        text: "Copy"
                        md_bg_color: 0.1, 0.3, 0.5, 1
                        text_color: 0.5, 0.7, 1.0, 1
